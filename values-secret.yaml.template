---
# NEVER COMMIT THESE VALUES TO GIT
version: "2.0"

# AO builds a postgresql+asyncpg URL and passes it through Alembic/configparser.
# Passwords with @, %, ^, etc. get percent-encoded and then break configparser
# interpolation. Keep generated AO DB passwords alphanumeric.
vaultPolicies:
  postgresPasswordPolicy: |
    length=24
    rule "charset" { charset = "abcdefghijklmnopqrstuvwxyz" min-chars = 1 }
    rule "charset" { charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" min-chars = 1 }
    rule "charset" { charset = "0123456789" min-chars = 1 }

secrets:
  - name: aap-manifest
    fields:
    - name: b64content
      path: 'full pathname of file containing Satellite Manifest for entitling Ansible Automation Platform'
      base64: true

  - name: automation-hub-token
    fields:
    - name: token
      value: 'An automation hub token for retrieving Certified and Validated Ansible content'

  - name: agof-vault-file
    fields:
    - name: agof-vault-file
      path: 'full pathname of a valid agof_vault file for secrets to overlay the iac config'
      base64: true

  # Used by aap-with-ao and complete-aap-ao (vp-cloudnative-pg-cluster).
  # temporal and temporal_visibility share the temporal role; set the same
  # password on both if you do not want independently generated passwords.
  - name: orchestrator-postgres-secret
    vaultPrefixes:
      - hub
    fields:
      - name: username
        value: orchestrator
      - name: password
        onMissingValue: generate
        vaultPolicy: postgresPasswordPolicy
      - name: database
        value: orchestrator
  - name: temporal-postgres-secret
    vaultPrefixes:
      - hub
    fields:
      - name: username
        value: temporal
      - name: password
        onMissingValue: generate
        vaultPolicy: postgresPasswordPolicy
      - name: database
        value: temporal
  - name: temporal-visibility-postgres-secret
    vaultPrefixes:
      - hub
    fields:
      - name: username
        value: temporal
      - name: password
        onMissingValue: generate
        vaultPolicy: postgresPasswordPolicy
      - name: database
        value: temporal_visibility
